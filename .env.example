# Copy to .env (never commit .env). On Render, set these in the dashboard
# (Environment) — the build writes them into config.json for the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# true only after enabling Google in Supabase → Authentication → Providers
GOOGLE_AUTH_ENABLED=false
